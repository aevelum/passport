t126_reject_venue_readiness_evidence_after_binding_freshness_expiry : Script ()
t126_reject_venue_readiness_evidence_after_binding_freshness_expiry = script do
  bound <- createVenueParticipantAdmissionBoundReadinessContext
  verifierBindings <- query @ReadinessBinding bound.presented.base.actors.verifier
  case verifierBindings of
    [(_, binding)] -> do
      evidenceCid <- createVenueReadinessEvidenceForBinding
        bound
        binding
        "venue-readiness-evidence-stale-binding"
        binding.bindingId
        VenueParticipantAdmissionUse
        "venue-profile:demo"
        binding.evidenceHash
      setTime venueReadinessStaleValidationTime
      submitMustFail bound.presented.base.actors.verifier do
        exerciseCmd evidenceCid ValidateVenueReadinessEvidence
    _ -> assertMsg "verifier should see one readiness binding before stale binding validation" False
  return ()
