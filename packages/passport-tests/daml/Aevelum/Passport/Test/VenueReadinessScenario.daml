module Aevelum.Passport.Test.VenueReadinessScenario where

import DA.Date
import DA.Time (time)
import Daml.Script
import Aevelum.Passport.Readiness.Types
import Aevelum.Passport.Readiness.Foundation
import Aevelum.Passport.VenueReadiness.Foundation
import Aevelum.Passport.VenueReadiness.Types
import Aevelum.Passport.Test.ReadinessScenario

venueReadinessStaleValidationTime : Time
venueReadinessStaleValidationTime = time (date 2026 May 11) 0 3 0

createVenueParticipantAdmissionBoundReadinessContext : Script ReadinessBoundContext
createVenueParticipantAdmissionBoundReadinessContext = script do
  base <- createBaseReadinessContext
  setTime readinessPresentationLedgerTime
  presentationCid <- submit base.actors.holder do
    exerciseCmd base.credentialCid PresentReadinessToVerifier with
      presentationId = "venue-readiness-presentation-001"
      verifier = base.actors.verifier
      presentationPurpose = VenueParticipantAdmissionBinding
      allowedFields = ["credentialId", "credentialKind", "policyId", "jurisdiction", "activityRefs"]
      presentedAt = "2026-05-10T00:03:00Z"
  let presented = ReadinessPresentedContext with base; presentationCid
  setTime readinessBindingLedgerTime
  bindingCid <- submit (actAs base.actors.holder <> actAs base.actors.attester <> actAs base.actors.verifier) do
    exerciseCmd presentationCid BindReadinessToContext with
      bindingId = "readiness-binding-venue-001"
      workflowRef = None
      venueProfileRef = Some "venue-profile:demo"
      venueRulebookRef = None
      bindingPurpose = VenueParticipantAdmissionBinding
      boundAt = "2026-05-10T00:04:00Z"
  return ReadinessBoundContext with presented; bindingCid

createVenueReadinessEvidenceForBinding :
  ReadinessBoundContext ->
  ReadinessBinding ->
  Text ->
  ReadinessBindingId ->
  VenueReadinessUse ->
  VenueProfileRef ->
  EvidenceHash ->
  Script (ContractId VenueReadinessEvidence)
createVenueReadinessEvidenceForBinding bound binding evidenceId evidenceBindingId evidenceUse evidenceVenueProfileRef evidenceHashValue = script do
  submit (actAs bound.presented.base.actors.holder <> actAs bound.presented.base.actors.attester <> actAs bound.presented.base.actors.verifier) do
    createCmd VenueReadinessEvidence with
      venueReadinessEvidenceId = evidenceId
      readinessBindingCid = bound.bindingCid
      bindingId = evidenceBindingId
      holder = bound.presented.base.actors.holder
      attester = bound.presented.base.actors.attester
      verifier = bound.presented.base.actors.verifier
      venueId = "venue:demo-markets"
      venueProfileRef = evidenceVenueProfileRef
      use = evidenceUse
      credentialKind = binding.credentialKind
      subject = binding.subject
      evidenceHash = evidenceHashValue
      createdAt = "2026-05-10T00:04:00Z"
      createdAtTime = readinessBindingLedgerTime
      schemaVersion = "readiness-0.3"

t118_create_venue_readiness_evidence_from_binding : Script ()
t118_create_venue_readiness_evidence_from_binding = script do
  bound <- createVenueParticipantAdmissionBoundReadinessContext
  verifierBindings <- query @ReadinessBinding bound.presented.base.actors.verifier
  case verifierBindings of
    [(_, binding)] -> do
      evidenceCid <- createVenueReadinessEvidenceForBinding
        bound
        binding
        "venue-readiness-evidence-001"
        binding.bindingId
        VenueParticipantAdmissionUse
        "venue-profile:demo"
        binding.evidenceHash
      submit bound.presented.base.actors.verifier do
        exerciseCmd evidenceCid ValidateVenueReadinessEvidence
      verifierEvidence <- query @VenueReadinessEvidence bound.presented.base.actors.verifier
      outsiderEvidence <- query @VenueReadinessEvidence bound.presented.base.actors.outsider
      assertMsg "verifier should see venue readiness evidence" (length verifierEvidence == 1)
      assertMsg "outsider should not see venue readiness evidence" (length outsiderEvidence == 0)
    _ -> assertMsg "verifier should see one readiness binding before venue evidence creation" False
  return ()

t120_validate_venue_readiness_evidence : Script ()
t120_validate_venue_readiness_evidence = script do
  bound <- createVenueParticipantAdmissionBoundReadinessContext
  verifierBindings <- query @ReadinessBinding bound.presented.base.actors.verifier
  case verifierBindings of
    [(_, binding)] -> do
      evidenceCid <- createVenueReadinessEvidenceForBinding
        bound
        binding
        "venue-readiness-evidence-validate-001"
        binding.bindingId
        VenueParticipantAdmissionUse
        "venue-profile:demo"
        binding.evidenceHash
      submit bound.presented.base.actors.verifier do
        exerciseCmd evidenceCid ValidateVenueReadinessEvidence
    _ -> assertMsg "verifier should see one readiness binding before venue evidence validation" False
  return ()

t121_reject_venue_readiness_evidence_with_wrong_binding_id : Script ()
t121_reject_venue_readiness_evidence_with_wrong_binding_id = script do
  bound <- createVenueParticipantAdmissionBoundReadinessContext
  verifierBindings <- query @ReadinessBinding bound.presented.base.actors.verifier
  case verifierBindings of
    [(_, binding)] -> do
      evidenceCid <- createVenueReadinessEvidenceForBinding
        bound
        binding
        "venue-readiness-evidence-wrong-binding-id"
        "readiness-binding-wrong"
        VenueParticipantAdmissionUse
        "venue-profile:demo"
        binding.evidenceHash
      submitMustFail bound.presented.base.actors.verifier do
        exerciseCmd evidenceCid ValidateVenueReadinessEvidence
    _ -> assertMsg "verifier should see one readiness binding before wrong binding id validation" False
  return ()

