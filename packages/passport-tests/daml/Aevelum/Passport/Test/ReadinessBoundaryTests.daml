module Aevelum.Passport.Test.ReadinessBoundaryTests where

import Daml.Script
import Aevelum.Passport.Readiness.Types
import Aevelum.Passport.Readiness.Foundation
import Aevelum.Passport.Test.ReadinessScenario

licenseScopeNotAttestationOnly : LicenseAttestationScope
licenseScopeNotAttestationOnly = LicenseAttestationScope with
  jurisdiction = "US-NY"
  externalAuthorityRef = "external-authority:ny-registry"
  registrationRef = "registration:holder-001"
  licensedActivityRefs = ["broker-dealer-readiness"]
  attestationOnly = False

t107_reject_license_attestation_without_scope : Script ()
t107_reject_license_attestation_without_scope = script do
  actors <- mkReadinessActors
  accountCid <- createReadinessAccount actors
  submitMustFail actors.holder do
    exerciseCmd accountCid RequestReadinessCredential with
      requestId = "license-request-without-scope-001"
      policyId = "readiness-policy-001"
      policyVersion = "v1"
      policyPublisher = actors.policyPublisher
      attester = actors.attester
      credentialKind = LicenseOrRegistrationAttestation
      subject = PartySubject actors.holder
      jurisdiction = "US-NY"
      activityRefs = ["broker-dealer-readiness"]
      licenseScope = None
      requestedAt = "2026-05-10T00:01:00Z"
  return ()

t108_reject_license_scope_when_attestation_only_false : Script ()
t108_reject_license_scope_when_attestation_only_false = script do
  actors <- mkReadinessActors
  accountCid <- createReadinessAccount actors
  submitMustFail actors.holder do
    exerciseCmd accountCid RequestReadinessCredential with
      requestId = "license-request-non-attestation-001"
      policyId = "readiness-policy-001"
      policyVersion = "v1"
      policyPublisher = actors.policyPublisher
      attester = actors.attester
      credentialKind = LicenseOrRegistrationAttestation
      subject = PartySubject actors.holder
      jurisdiction = "US-NY"
      activityRefs = ["broker-dealer-readiness"]
      licenseScope = Some licenseScopeNotAttestationOnly
      requestedAt = "2026-05-10T00:01:00Z"
  return ()

t109_reject_unapproved_credential_kind : Script ()
t109_reject_unapproved_credential_kind = script do
  actors <- mkReadinessActors
  accountCid <- createReadinessAccount actors
  policyCid <- createReadinessPolicyWith actors [ParticipantEligibilityCredential] ["US-NY"] ["treasury-product"] 24 readinessPolicyValidUntilTime
  requestCid <- requestReadinessCredential
    accountCid
    actors
    ProductEligibilityCredential
    (ProductSubject "UST")
    "US-NY"
    ["treasury-product"]
    None
  setTime readinessIssueLedgerTime
  submitMustFail (actAs actors.holder <> actAs actors.attester) do
    exerciseCmd requestCid IssueReadinessCredential with
      credentialId = "unapproved-kind-credential-001"
      policyCid
      evidenceHash = "sha256:readiness-evidence-unapproved-kind"
      calculationMethodHash = "sha256:readiness-calculation-unapproved-kind"
      validFrom = "2026-05-10T00:02:00Z"
      validFromTime = readinessIssueLedgerTime
      validUntil = "2026-05-12T00:02:00Z"
      validUntilTime = readinessCredentialValidUntilTime
      issuedAt = "2026-05-10T00:02:00Z"
  return ()

