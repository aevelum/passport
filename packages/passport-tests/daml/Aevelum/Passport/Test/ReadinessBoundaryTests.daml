t119_readiness_binding_is_non_executing_evidence_only : Script ()
t119_readiness_binding_is_non_executing_evidence_only = script do
  bound <- createBoundReadinessContext
  verifierBindings <- query @ReadinessBinding bound.presented.base.actors.verifier
  verifierPresentations <- query @ReadinessPresentation bound.presented.base.actors.verifier
  case verifierBindings of
    [(_, binding)] -> do
      assertMsg "readiness binding keeps workflow context as reference metadata" (binding.workflowRef == Some "markets-workflow:participant-check")
      assertMsg "readiness binding carries evidence hash only" (binding.evidenceHash == "sha256:readiness-evidence-001")
    _ -> assertMsg "verifier should see exactly one readiness binding" False
  assertMsg "binding is nonconsuming and leaves the presentation visible to verifier" (length verifierPresentations == 1)
  return ()
