module Aevelum.Passport.VenueReadiness.Foundation where

import Aevelum.Passport.Types
import Aevelum.Passport.Readiness.Types
import Aevelum.Passport.Readiness.Foundation
import Aevelum.Passport.VenueReadiness.Types

template VenueReadinessEvidence
  with
    venueReadinessEvidenceId : Text
    readinessBindingCid : ContractId ReadinessBinding
    bindingId : ReadinessBindingId
    holder : Party
    attester : Party
    verifier : Party
    venueId : VenueId
    venueProfileRef : VenueProfileRef
    use : VenueReadinessUse
    credentialKind : ReadinessCredentialKind
    subject : ReadinessSubject
    evidenceHash : EvidenceHash
    createdAt : IsoTimestamp
    createdAtTime : Time
    schemaVersion : Text
  where
    signatory holder, attester, verifier

    ensure
      venueReadinessEvidenceId /= ""
        && bindingId /= ""
        && venueId /= ""
        && venueProfileRef /= ""
        && evidenceHash /= ""
        && createdAt /= ""

    nonconsuming choice ValidateVenueReadinessEvidence : ()
      controller verifier
      do
        now <- getTime
        binding <- fetch readinessBindingCid

        assertMsg "venue readiness evidence binding id must match binding"
          (binding.bindingId == bindingId)
        assertMsg "venue readiness binding credential must not be expired at validation ledger time"
          (now < binding.credentialValidUntilTime)
        assertMsg "venue readiness binding credential must not be stale at validation ledger time"
          (now < binding.credentialFreshUntilTime)
        assertMsg "venue readiness evidence holder must match binding"
          (binding.holder == holder)
        assertMsg "venue readiness evidence attester must match binding"
          (binding.attester == attester)
        assertMsg "venue readiness evidence verifier must match binding"
          (binding.verifier == verifier)
        assertMsg "venue readiness evidence credential kind must match binding"
          (binding.credentialKind == credentialKind)
        assertMsg "venue readiness evidence subject must match binding"
          (binding.subject == subject)
        assertMsg "venue readiness evidence hash must match binding"
          (binding.evidenceHash == evidenceHash)
        assertMsg "venue readiness use must match binding purpose"
          (readinessUseMatchesBindingPurpose use binding.bindingPurpose)
        assertMsg "venue readiness evidence profile must match binding profile context"
          (binding.venueProfileRef == Some venueProfileRef)
        return ()
