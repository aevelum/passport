module Aevelum.Passport.Readiness.Foundation where

import DA.Time (addRelTime, hours)
import Aevelum.Passport.Types
import Aevelum.Passport.Readiness.Types

template ReadinessAccount
  with
    accountId : ReadinessAccountId
    holder : Party
    operator : Optional Party
    displayName : Text
    schemaVersion : Text
    createdAt : IsoTimestamp
    status : ReadinessAccountStatus
  where
    signatory holder
    observer case operator of
      Some op -> op
      None -> holder

    ensure status == ReadinessAccountActive && accountId /= "" && displayName /= ""

    nonconsuming choice RequestReadinessCredential : ContractId ReadinessCredentialRequest
      with
        requestId : ReadinessRequestId
        policyId : ReadinessPolicyId
        policyVersion : ReadinessPolicyVersion
        policyPublisher : Party
        attester : Party
        credentialKind : ReadinessCredentialKind
        subject : ReadinessSubject
        jurisdiction : JurisdictionRef
        activityRefs : [Text]
        licenseScope : Optional LicenseAttestationScope
        requestedAt : IsoTimestamp
      controller holder
      do
        now <- getTime
        assertMsg "readiness request id must be present" (requestId /= "")
        assertMsg "readiness policy id must be present" (policyId /= "")
        assertMsg "readiness policy version must be present" (policyVersion /= "")
        assertMsg "readiness jurisdiction must be present" (jurisdiction /= "")
        assertMsg "readiness request must name at least one activity" (not (null activityRefs))
        assertMsg "license registration readiness requires valid attestation-only scope"
          (validReadinessKindScopeForJurisdiction credentialKind jurisdiction licenseScope)
        create ReadinessCredentialRequest with
          requestId
          accountId
          holder
          policyId
          policyVersion
          policyPublisher
          attester
          credentialKind
          subject
          jurisdiction
          activityRefs
          licenseScope
          requestedAt
          requestedAtTime = now
          status = "Requested"
          schemaVersion

    choice CloseReadinessAccount : ()
      with
        closedAt : IsoTimestamp
      controller holder
      do
        return ()

template ReadinessPolicy
  with
    policyId : ReadinessPolicyId
    policyVersion : ReadinessPolicyVersion
    policyPublisher : Party
    approvedHolders : [Party]
    approvedAttesters : [Party]
    approvedVerifiers : [Party]
    approvedCredentialKinds : [ReadinessCredentialKind]
    approvedJurisdictions : [JurisdictionRef]
    approvedActivityRefs : [Text]
    freshnessWindowHours : Int
    validFrom : IsoTimestamp
    validFromTime : Time
    validUntil : IsoTimestamp
    validUntilTime : Time
    schemaVersion : Text
    status : ReadinessPolicyStatus
  where
    signatory policyPublisher
    observer approvedHolders, approvedAttesters, approvedVerifiers

    ensure
      policyId /= ""
        && policyVersion /= ""
        && status == ReadinessPolicyActive
        && not (null approvedHolders)
        && not (null approvedAttesters)
        && not (null approvedVerifiers)
        && not (null approvedCredentialKinds)
        && not (null approvedJurisdictions)
        && not (null approvedActivityRefs)
        && freshnessWindowHours > 0
        && coherentTimeWindow validFromTime validUntilTime

    nonconsuming choice ValidateReadinessPolicyActiveAtLedgerTime : ()
      controller policyPublisher
      do
        now <- getTime
        assertMsg "readiness policy not yet valid at ledger time" (now >= validFromTime)
        assertMsg "readiness policy expired at ledger time" (now < validUntilTime)
        return ()

    choice RetireReadinessPolicy : ContractId ReadinessPolicyLifecycleEvent
      with
        retiredAt : IsoTimestamp
        reason : Text
      controller policyPublisher
      do
        now <- getTime
        create ReadinessPolicyLifecycleEvent with
          eventId = policyId <> ":retired:" <> retiredAt
          policyId
          policyVersion
          policyPublisher
          eventType = "Retired"
          eventTime = retiredAt
          eventTimeValue = now
          reason
          schemaVersion

template ReadinessPolicyLifecycleEvent
  with
    eventId : Text
    policyId : ReadinessPolicyId
    policyVersion : ReadinessPolicyVersion
    policyPublisher : Party
    eventType : Text
    eventTime : IsoTimestamp
    eventTimeValue : Time
    reason : Text
    schemaVersion : Text
  where
    signatory policyPublisher
    ensure eventId /= "" && policyId /= "" && policyVersion /= ""

template ReadinessCredentialRequest
  with
    requestId : ReadinessRequestId
    accountId : ReadinessAccountId
    holder : Party
    policyId : ReadinessPolicyId
    policyVersion : ReadinessPolicyVersion
    policyPublisher : Party
    attester : Party
    credentialKind : ReadinessCredentialKind
    subject : ReadinessSubject
    jurisdiction : JurisdictionRef
    activityRefs : [Text]
    licenseScope : Optional LicenseAttestationScope
    requestedAt : IsoTimestamp
    requestedAtTime : Time
    status : Text
    schemaVersion : Text
  where
    signatory holder
    observer policyPublisher, attester

    ensure
      requestId /= ""
        && accountId /= ""
        && jurisdiction /= ""
        && not (null activityRefs)
        && validReadinessKindScopeForJurisdiction credentialKind jurisdiction licenseScope

    choice IssueReadinessCredential : ContractId ReadinessCredential
      with
        credentialId : ReadinessCredentialId
        policyCid : ContractId ReadinessPolicy
        evidenceHash : EvidenceHash
        calculationMethodHash : CalculationMethodHash
        validFrom : IsoTimestamp
        validFromTime : Time
        validUntil : IsoTimestamp
        validUntilTime : Time
        issuedAt : IsoTimestamp
      controller holder, attester
      do
        now <- getTime
        policy <- fetch policyCid
        let freshUntilTime = addRelTime now (hours policy.freshnessWindowHours)

        assertMsg "readiness credential id must be present" (credentialId /= "")
        assertMsg "readiness evidence hash must be present" (evidenceHash /= "")
        assertMsg "readiness calculation method hash must be present" (calculationMethodHash /= "")
        assertMsg "readiness policy id must match request" (policy.policyId == policyId)
        assertMsg "readiness policy version must match request" (policy.policyVersion == policyVersion)
        assertMsg "readiness policy publisher must match request" (policy.policyPublisher == policyPublisher)
        assertMsg "readiness policy must be active" (policy.status == ReadinessPolicyActive)
        assertMsg "readiness policy must approve holder" (elem holder policy.approvedHolders)
        assertMsg "readiness policy must approve attester" (elem attester policy.approvedAttesters)
        assertMsg "readiness policy must approve credential kind" (elem credentialKind policy.approvedCredentialKinds)
        assertMsg "readiness policy must approve jurisdiction" (elem jurisdiction policy.approvedJurisdictions)
        assertMsg "readiness policy typed validity must be active" (withinTimeWindow now policy.validFromTime policy.validUntilTime)
        assertMsg "readiness credential validity window must be coherent" (coherentTimeWindow validFromTime validUntilTime)
        assertMsg "readiness credential must be active at issuance ledger time" (withinTimeWindow now validFromTime validUntilTime)
        assertMsg "readiness request activities must be policy approved" (all (\activity -> elem activity policy.approvedActivityRefs) activityRefs)
        assertMsg "license registration readiness requires valid attestation-only scope"
          (validReadinessKindScopeForJurisdiction credentialKind jurisdiction licenseScope)

        activeStatusCid <- create ReadinessCredentialActiveStatus with
          statusId = credentialId <> ":active"
          credentialId
          holder
          attester
          approvedVerifiers = policy.approvedVerifiers
          evidenceHash
          validFromTime
          validUntilTime
          freshUntilTime
          schemaVersion

        create ReadinessCredential with
          credentialId
          activeStatusCid
          holder
          attester
          policyPublisher
          policyId
          policyVersion
          approvedVerifiers = policy.approvedVerifiers
          credentialKind
          subject
          jurisdiction
          activityRefs
          licenseScope
          evidenceHash
          calculationMethodHash
          issuedAt
          issuedAtTime = now
          validFrom
          validFromTime
          validUntil
          validUntilTime
          freshnessWindowHours = policy.freshnessWindowHours
          freshUntilTime
          status = ReadinessCredentialActive
          schemaVersion

template ReadinessCredentialActiveStatus
  with
    statusId : Text
    credentialId : ReadinessCredentialId
    holder : Party
    attester : Party
    approvedVerifiers : [Party]
    evidenceHash : EvidenceHash
    validFromTime : Time
    validUntilTime : Time
    freshUntilTime : Time
    schemaVersion : Text
  where
    signatory holder, attester
    observer approvedVerifiers

    ensure
      statusId /= ""
        && credentialId /= ""
        && not (null approvedVerifiers)
        && evidenceHash /= ""
        && coherentTimeWindow validFromTime validUntilTime
        && freshUntilTime > validFromTime

    choice DeactivateReadinessCredentialActiveStatus : ()
      controller attester
      do
        return ()

template ReadinessCredential
  with
    credentialId : ReadinessCredentialId
    activeStatusCid : ContractId ReadinessCredentialActiveStatus
    holder : Party
    attester : Party
    policyPublisher : Party
    policyId : ReadinessPolicyId
    policyVersion : ReadinessPolicyVersion
    approvedVerifiers : [Party]
    credentialKind : ReadinessCredentialKind
    subject : ReadinessSubject
    jurisdiction : JurisdictionRef
    activityRefs : [Text]
    licenseScope : Optional LicenseAttestationScope
    evidenceHash : EvidenceHash
    calculationMethodHash : CalculationMethodHash
    issuedAt : IsoTimestamp
    issuedAtTime : Time
    validFrom : IsoTimestamp
    validFromTime : Time
    validUntil : IsoTimestamp
    validUntilTime : Time
    freshnessWindowHours : Int
    freshUntilTime : Time
    status : ReadinessCredentialStatus
    schemaVersion : Text
  where
    signatory holder, attester

    ensure
      credentialId /= ""
        && status == ReadinessCredentialActive
        && not (null approvedVerifiers)
        && jurisdiction /= ""
        && not (null activityRefs)
        && evidenceHash /= ""
        && calculationMethodHash /= ""
        && validReadinessKindScopeForJurisdiction credentialKind jurisdiction licenseScope
        && coherentTimeWindow validFromTime validUntilTime
        && withinTimeWindow issuedAtTime validFromTime validUntilTime
        && freshnessWindowHours > 0
        && freshUntilTime == addRelTime issuedAtTime (hours freshnessWindowHours)

    nonconsuming choice PresentReadinessToVerifier : ContractId ReadinessPresentation
      with
        presentationId : ReadinessPresentationId
        verifier : Party
        presentationPurpose : ReadinessBindingPurpose
        allowedFields : [Text]
        presentedAt : IsoTimestamp
      controller holder
      do
        now <- getTime
        let presentationValidUntilTime =
              if validUntilTime <= freshUntilTime then validUntilTime else freshUntilTime

        assertMsg "readiness presentation id must be present" (presentationId /= "")
        assertMsg "readiness presentation must name allowed fields" (not (null allowedFields))
        assertMsg "readiness verifier must be approved by policy" (elem verifier approvedVerifiers)
        assertMsg "readiness credential not yet valid at presentation ledger time" (now >= validFromTime)
        assertMsg "readiness credential expired at presentation ledger time" (now < validUntilTime)
        assertMsg "readiness credential stale at presentation ledger time" (now < freshUntilTime)

        create ReadinessPresentation with
          presentationId
          sourceCredentialCid = self
          sourceCredentialActiveStatusCid = activeStatusCid
          credentialId
          holder
          attester
          verifier
          policyPublisher
          policyId
          policyVersion
          credentialKind
          subject
          jurisdiction
          activityRefs
          licenseScope
          allowedFields
          evidenceHash
          calculationMethodHash
          validFrom
          validFromTime
          validUntil
          validUntilTime
          freshnessWindowHours
          freshUntilTime
          presentationValidUntilTime
          presentationPurpose
          presentedAt
          presentedAtTime = now
          schemaVersion

    nonconsuming choice GrantReadinessAuditDisclosure : ContractId ReadinessAuditDisclosureGrant
      with
        grantId : ReadinessGrantId
        auditor : Party
        allowedFields : [Text]
        validFrom : IsoTimestamp
        validFromTime : Time
        validUntil : IsoTimestamp
        validUntilTime : Time
        legalBasisRef : Text
      controller holder, attester
      do
        now <- getTime
        credential <- fetch self
        assertMsg "readiness audit grant id must be present" (grantId /= "")
        assertMsg "readiness audit grant must name allowed fields" (not (null allowedFields))
        assertMsg "readiness audit grant validity window must be coherent" (coherentTimeWindow validFromTime validUntilTime)
        assertMsg "readiness credential must be active at audit grant ledger time" (withinTimeWindow now credential.validFromTime credential.validUntilTime)
        assertMsg "readiness audit grant must start inside credential validity" (validFromTime >= credential.validFromTime)
        assertMsg "readiness audit grant must not outlive credential validity" (validUntilTime <= credential.validUntilTime)
        create ReadinessAuditDisclosureGrant with
          grantId
          credentialId
          holder
          attester
          auditor
          allowedFields
          evidenceHash
          validFrom
          validFromTime
          validUntil
          validUntilTime
          legalBasisRef
          schemaVersion

    choice RevokeReadinessCredential : ContractId ReadinessRevocation
      with
        revocationId : ReadinessRevocationId
        reasonCode : ReadinessRevocationReason
        revokedAt : IsoTimestamp
        priorVerifiers : [Party]
        supersedingCredentialId : Optional ReadinessCredentialId
      controller attester
      do
        now <- getTime
        exercise activeStatusCid DeactivateReadinessCredentialActiveStatus
        create ReadinessRevocation with
          revocationId
          credentialId
          holder
          attester
          priorVerifiers
          reasonCode
          revokedAt
          revokedAtTime = now
          supersedingCredentialId
          schemaVersion

template ReadinessPresentation
  with
    presentationId : ReadinessPresentationId
    sourceCredentialCid : ContractId ReadinessCredential
    sourceCredentialActiveStatusCid : ContractId ReadinessCredentialActiveStatus
    credentialId : ReadinessCredentialId
    holder : Party
    attester : Party
    verifier : Party
    policyPublisher : Party
    policyId : ReadinessPolicyId
    policyVersion : ReadinessPolicyVersion
    credentialKind : ReadinessCredentialKind
    subject : ReadinessSubject
    jurisdiction : JurisdictionRef
    activityRefs : [Text]
    licenseScope : Optional LicenseAttestationScope
    allowedFields : [Text]
    evidenceHash : EvidenceHash
    calculationMethodHash : CalculationMethodHash
    validFrom : IsoTimestamp
    validFromTime : Time
    validUntil : IsoTimestamp
    validUntilTime : Time
    freshnessWindowHours : Int
    freshUntilTime : Time
    presentationValidUntilTime : Time
    presentationPurpose : ReadinessBindingPurpose
    presentedAt : IsoTimestamp
    presentedAtTime : Time
    schemaVersion : Text
  where
    signatory holder
    observer verifier, attester

    ensure
      presentationId /= ""
        && credentialId /= ""
        && jurisdiction /= ""
        && not (null activityRefs)
        && not (null allowedFields)
        && validReadinessKindScopeForJurisdiction credentialKind jurisdiction licenseScope
        && coherentTimeWindow validFromTime validUntilTime
        && presentedAtTime >= validFromTime
        && presentedAtTime < presentationValidUntilTime
        && presentationValidUntilTime <= validUntilTime
        && presentationValidUntilTime <= freshUntilTime

    nonconsuming choice BindReadinessToContext : ContractId ReadinessBinding
      with
        bindingId : ReadinessBindingId
        workflowRef : Optional WorkflowRef
        venueProfileRef : Optional VenueProfileRef
        venueRulebookRef : Optional VenueRulebookRef
        bindingPurpose : ReadinessBindingPurpose
        boundAt : IsoTimestamp
      controller holder, attester, verifier
      do
        now <- getTime
        credential <- fetch sourceCredentialCid
        activeStatus <- fetch sourceCredentialActiveStatusCid
        assertMsg "readiness binding id must be present" (bindingId /= "")
        assertMsg "readiness binding source credential must be active" (credential.status == ReadinessCredentialActive)
        assertMsg "readiness binding source active status id must match presentation" (activeStatus.credentialId == credentialId)
        assertMsg "readiness binding source active status holder must match presentation" (activeStatus.holder == holder)
        assertMsg "readiness binding source active status attester must match presentation" (activeStatus.attester == attester)
        assertMsg "readiness binding source active status evidence hash must match presentation" (activeStatus.evidenceHash == evidenceHash)
        assertMsg "readiness binding source active status must be active at binding ledger time" (withinTimeWindow now activeStatus.validFromTime activeStatus.validUntilTime)
        assertMsg "readiness binding source active status must be fresh at binding ledger time" (now < activeStatus.freshUntilTime)
        assertMsg "readiness binding source credential id must match presentation" (credential.credentialId == credentialId)
        assertMsg "readiness binding source credential holder must match presentation" (credential.holder == holder)
        assertMsg "readiness binding source credential attester must match presentation" (credential.attester == attester)
        assertMsg "readiness binding source credential policy publisher must match presentation" (credential.policyPublisher == policyPublisher)
        assertMsg "readiness binding source credential policy id must match presentation" (credential.policyId == policyId)
        assertMsg "readiness binding source credential policy version must match presentation" (credential.policyVersion == policyVersion)
        assertMsg "readiness binding source credential kind must match presentation" (credential.credentialKind == credentialKind)
        assertMsg "readiness binding source credential subject must match presentation" (credential.subject == subject)
        assertMsg "readiness binding source credential jurisdiction must match presentation" (credential.jurisdiction == jurisdiction)
        assertMsg "readiness binding source credential activities must match presentation" (credential.activityRefs == activityRefs)
        assertMsg "readiness binding source credential license scope must match presentation" (credential.licenseScope == licenseScope)
        assertMsg "readiness binding source credential evidence hash must match presentation" (credential.evidenceHash == evidenceHash)
        assertMsg "readiness binding source credential calculation method hash must match presentation" (credential.calculationMethodHash == calculationMethodHash)
        assertMsg "readiness binding source credential must be active at binding ledger time" (withinTimeWindow now credential.validFromTime credential.validUntilTime)
        assertMsg "readiness binding source credential must be fresh at binding ledger time" (now < credential.freshUntilTime)
        assertMsg "readiness presentation expired at binding ledger time" (now < presentationValidUntilTime)
        assertMsg "readiness binding must name workflow, venue profile, or rulebook context" (hasReadinessContext workflowRef venueProfileRef venueRulebookRef)
        assertMsg "readiness binding purpose must match presentation purpose" (bindingPurpose == presentationPurpose)
        create ReadinessBinding with
          bindingId
          presentationId
          sourceCredentialCid
          sourceCredentialActiveStatusCid
          credentialId
          holder
          attester
          verifier
          policyPublisher
          policyId
          policyVersion
          credentialKind
          subject
          jurisdiction
          activityRefs
          licenseScope
          workflowRef
          venueProfileRef
          venueRulebookRef
          bindingPurpose
          evidenceHash
          calculationMethodHash
          boundAt
          boundAtTime = now
          credentialValidUntilTime = validUntilTime
          credentialFreshUntilTime = freshUntilTime
          schemaVersion

template ReadinessBinding
  with
    bindingId : ReadinessBindingId
    presentationId : ReadinessPresentationId
    sourceCredentialCid : ContractId ReadinessCredential
    sourceCredentialActiveStatusCid : ContractId ReadinessCredentialActiveStatus
    credentialId : ReadinessCredentialId
    holder : Party
    attester : Party
    verifier : Party
    policyPublisher : Party
    policyId : ReadinessPolicyId
    policyVersion : ReadinessPolicyVersion
    credentialKind : ReadinessCredentialKind
    subject : ReadinessSubject
    jurisdiction : JurisdictionRef
    activityRefs : [Text]
    licenseScope : Optional LicenseAttestationScope
    workflowRef : Optional WorkflowRef
    venueProfileRef : Optional VenueProfileRef
    venueRulebookRef : Optional VenueRulebookRef
    bindingPurpose : ReadinessBindingPurpose
    evidenceHash : EvidenceHash
    calculationMethodHash : CalculationMethodHash
    boundAt : IsoTimestamp
    boundAtTime : Time
    credentialValidUntilTime : Time
    credentialFreshUntilTime : Time
    schemaVersion : Text
  where
    signatory holder, attester, verifier

    ensure
      bindingId /= ""
        && presentationId /= ""
        && credentialId /= ""
        && jurisdiction /= ""
        && not (null activityRefs)
        && evidenceHash /= ""
        && calculationMethodHash /= ""
        && validReadinessKindScopeForJurisdiction credentialKind jurisdiction licenseScope
        && hasReadinessContext workflowRef venueProfileRef venueRulebookRef
        && boundAtTime < credentialValidUntilTime
        && boundAtTime < credentialFreshUntilTime

template ReadinessRevocation
  with
    revocationId : ReadinessRevocationId
    credentialId : ReadinessCredentialId
    holder : Party
    attester : Party
    priorVerifiers : [Party]
    reasonCode : ReadinessRevocationReason
    revokedAt : IsoTimestamp
    revokedAtTime : Time
    supersedingCredentialId : Optional ReadinessCredentialId
    schemaVersion : Text
  where
    signatory attester
    observer holder, priorVerifiers

    ensure revocationId /= "" && credentialId /= ""

template ReadinessAuditDisclosureGrant
  with
    grantId : ReadinessGrantId
    credentialId : ReadinessCredentialId
    holder : Party
    attester : Party
    auditor : Party
    allowedFields : [Text]
    evidenceHash : EvidenceHash
    validFrom : IsoTimestamp
    validFromTime : Time
    validUntil : IsoTimestamp
    validUntilTime : Time
    legalBasisRef : Text
    schemaVersion : Text
  where
    signatory holder, attester
    observer auditor

    ensure
      grantId /= ""
        && credentialId /= ""
        && not (null allowedFields)
        && evidenceHash /= ""
        && coherentTimeWindow validFromTime validUntilTime

hasReadinessContext : Optional WorkflowRef -> Optional VenueProfileRef -> Optional VenueRulebookRef -> Bool
hasReadinessContext workflowRef venueProfileRef venueRulebookRef =
  case workflowRef of
    Some ref -> ref /= ""
    None ->
      case venueProfileRef of
        Some ref -> ref /= ""
        None ->
          case venueRulebookRef of
            Some ref -> ref /= ""
            None -> False
